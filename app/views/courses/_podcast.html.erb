<%# "Listen to this course": the course's podcast episodes from Cloudflare R2 (CoursePodcast, podcast_controller.js).
    Locals: episodes (CoursePodcast::Episode list); locked (no plan: show the episodes but no audio, with a link to the plans).
    The free demo podcast on the home page is home/_podcast, not this. %>
<% locked = local_assigns.fetch(:locked, false) %>
<% fmt = ->(s) { "#{s / 60}:#{format('%02d', s % 60)}" } %>
<section class="cp" aria-label="Course podcast">
  <div class="cp-head">
    <span class="cp-icon" aria-hidden="true">🎧</span>
    <div>
      <h2><%= local_assigns.fetch(:heading, "Listen to this course") %></h2>
      <p><%= local_assigns.fetch(:intro, "A podcast overview of the course. Listen before you start, or while you travel.") %></p>
    </div>
  </div>
  <% if locked %>
    <% episodes.each_with_index do |ep, i| %>
      <div class="cp-ep cp-ep-locked">
        <div class="cp-ep-text">
          <% if episodes.size > 1 %><span class="cp-ep-num">Episode <%= i + 1 %></span><% end %>
          <p class="cp-ep-title"><%= ep.title %></p>
          <p class="cp-ep-meta"><%= ep.languages.map { |l| l[:name] }.join(", ") %> · <%= fmt.(ep.languages.first[:seconds]) %></p>
        </div>
        <div class="cp-lock">
          <span class="cp-lock-icon" aria-hidden="true">🔒</span>
          <p>Course podcasts come with a plan.</p>
          <%= link_to "See plans", pricing_path, class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    <% end %>
  <% end %>
  <% (locked ? [] : episodes).each_with_index do |ep, i| %>
    <% first = ep.languages.first %>
    <div class="cp-ep" data-controller="podcast" data-podcast-languages-value="<%= ep.languages.to_json %>" data-podcast-title-value="<%= ep.title %>">
      <div class="cp-ep-top">
        <div class="cp-ep-text">
          <% if episodes.size > 1 %><span class="cp-ep-num">Episode <%= i + 1 %></span><% end %>
          <p class="cp-ep-title"><%= ep.title %></p>
          <p class="cp-ep-meta"><span data-podcast-target="langName"><%= first[:name] %></span> · CoffeeBean AI</p>
        </div>
        <% if ep.languages.size > 1 %>
          <div class="cp-langs" role="group" aria-label="Podcast language">
            <% ep.languages.each do |l| %>
              <button type="button" class="bc-lang" lang="<%= l[:code] %>" title="<%= l[:name] %>" aria-pressed="<%= l == first %>"
                      data-podcast-target="lang" data-action="podcast#pickLanguage" data-code="<%= l[:code] %>"><%= l[:label] %></button>
            <% end %>
          </div>
        <% end %>
      </div>
      <div class="cp-player">
        <button type="button" class="bc-play cp-play" aria-label="Play" data-podcast-target="play" data-action="podcast#toggle">
          <svg class="bc-icon-play" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"/></svg>
          <svg class="bc-icon-pause" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="4.5" width="4.2" height="15" rx="1.2"/><rect x="13.8" y="4.5" width="4.2" height="15" rx="1.2"/></svg>
        </button>
        <button type="button" class="bc-ctl" aria-label="Back 10 seconds" data-action="podcast#back">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><text x="12" y="15.5" font-size="7.5" font-weight="700" text-anchor="middle" fill="currentColor" stroke="none">10</text></svg>
        </button>
        <div class="bc-progress cp-progress">
          <input type="range" min="0" max="<%= first[:seconds] %>" step="0.1" value="0" aria-label="Seek" data-podcast-target="seek" data-action="input->podcast#seek">
          <div class="bc-times"><span data-podcast-target="current">0:00</span><span data-podcast-target="duration"><%= fmt.(first[:seconds]) %></span></div>
        </div>
        <button type="button" class="bc-ctl" aria-label="Forward 10 seconds" data-action="podcast#forward">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/><text x="12" y="15.5" font-size="7.5" font-weight="700" text-anchor="middle" fill="currentColor" stroke="none">10</text></svg>
        </button>
        <button type="button" class="bc-speed cp-speed" aria-label="Playback speed" data-podcast-target="speed" data-action="podcast#cycleSpeed">1×</button>
      </div>
      <audio preload="none" data-podcast-target="audio"
             data-action="play->podcast#playing pause->podcast#paused ended->podcast#ended timeupdate->podcast#tick loadedmetadata->podcast#loaded error->podcast#failed"></audio>
      <p class="bc-error" data-podcast-target="error" hidden>This podcast could not load. Please try again later.</p>
    </div>
  <% end %>
</section>
