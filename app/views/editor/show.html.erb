<% content_for :title, "Editor - CoffeeBean AI" %>
<% content_for :noindex, "1" %>
<% content_for :body_class, "editor-body" %>

<%
  default_html = <<~HTML
    <header class="topbar">
      <span class="logo">🍦 Scoop Street</span>
      <nav>
        <a href="#menu">Menu</a>
        <a href="#about">About</a>
        <a href="#visit">Visit us</a>
      </nav>
    </header>

    <section class="hero">
      <p class="eyebrow">Fresh every morning in Maharashtra</p>
      <h1>Ice-Cream Shop</h1>
      <p>Creamy scoops made with real milk and fruit.</p>
      <div class="big-cone">🍨</div>
    </section>

    <section class="menu" id="menu">
      <h2>Our menu</h2>
      <div class="flavours">
        <div class="card" style="--c:#ffb3c7">
          <div class="emoji">🍓</div>
          <h3>Strawberry</h3>
          <p class="price">₹80</p>
        </div>
        <div class="card" style="--c:#c69c6d">
          <div class="emoji">🍫</div>
          <h3>Chocolate</h3>
          <p class="price">₹90</p>
        </div>
        <div class="card" style="--c:#ffe08a">
          <div class="emoji">🥭</div>
          <h3>Mango</h3>
          <p class="price">₹100</p>
        </div>
        <div class="card" style="--c:#b8e6c9">
          <div class="emoji">🌿</div>
          <h3>Pista</h3>
          <p class="price">₹110</p>
        </div>
      </div>
    </section>

    <section class="about" id="about">
      <h2>About us</h2>
      <p>We are a small family shop. We make every flavour in our kitchen each morning.</p>
    </section>

    <section class="visit" id="visit">
      <h2>Visit us</h2>
      <p>12 Main Road, Maharashtra</p>
      <p>Open every day, 11 am to 10 pm</p>
    </section>

    <footer class="footer">
      <p>© <span id="year"></span> Scoop Street</p>
    </footer>
  HTML

  default_css = <<~CSS
    body {
      margin: 0;
      font-family: Inter, Arial, sans-serif;
      background: #fff7fb;
      color: #3b2230;
    }

    .topbar {
      position: sticky;
      top: 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 32px;
      background: white;
      box-shadow: 0 2px 12px rgba(236, 72, 153, 0.12);
    }

    .logo {
      font-size: 22px;
      font-weight: 800;
      color: #db2777;
    }

    nav a {
      margin-left: 20px;
      color: #3b2230;
      font-weight: 600;
      text-decoration: none;
    }

    nav a:hover {
      color: #db2777;
    }

    .hero {
      text-align: center;
      padding: 56px 24px 24px;
      background: linear-gradient(180deg, #ffe4f0, #fff7fb);
    }

    .eyebrow {
      color: #db2777;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    h1 {
      margin: 8px 0;
      font-size: clamp(40px, 8vw, 72px);
      color: #9d174d;
    }

    .hero p {
      font-size: 18px;
    }

    .big-cone {
      font-size: 100px;
      margin-top: 8px;
    }

    .menu,
    .about,
    .visit {
      scroll-margin-top: 70px;
      max-width: 900px;
      margin: 0 auto;
      padding: 32px 24px;
      text-align: center;
    }

    .flavours {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 18px;
    }

    .card {
      background: white;
      border-radius: 20px;
      padding: 20px;
      border-top: 8px solid var(--c);
      box-shadow: 0 10px 30px rgba(157, 23, 77, 0.1);
    }

    .emoji {
      font-size: 50px;
    }

    .card h3 {
      margin: 8px 0 4px;
    }

    .price {
      font-size: 20px;
      font-weight: 800;
      color: #db2777;
      margin: 0;
    }

    .about p,
    .visit p {
      font-size: 17px;
      line-height: 1.6;
      margin: 6px 0;
    }

    .footer {
      text-align: center;
      padding: 20px;
      background: #9d174d;
      color: white;
    }
  CSS

  default_js = <<~JS
    // Show this year in the footer.
    document.querySelector("#year").textContent = new Date().getFullYear();
  JS
%>

<div class="editor-page" data-controller="editor">
  <%= render "shared/navbar" %>

  <main class="try-editor">
    <section class="try-editor__left">
      <div class="try-editor__toolbar">
        <div class="editor-page-fields">
          <label>
            Page title
            <input type="text"
                   value="My Ice-Cream Shop"
                   data-editor-target="pageTitle"
                   data-action="input->editor#syncSlug">
          </label>
          <label>
            Slug
            <input type="text"
                   value="my-ice-cream-shop"
                   data-editor-target="pageSlug"
                   data-action="input->editor#markSlugEdited">
          </label>
        </div>

        <div class="try-editor__actions">
          <button type="button" class="try-btn try-btn--primary" data-action="editor#run">Run</button>
          <button type="button" class="try-btn try-btn--publish" data-action="editor#updatePublishedPage">Publish</button>
          <button type="button" class="try-btn try-btn--ghost" data-action="editor#reset">Reset</button>
        </div>
      </div>

      <div class="editor-upload-card">
        <div>
          <strong>Upload Image</strong>
          <span>PNG, JPG, GIF or WebP. Use the generated URL inside your HTML.</span>
        </div>
        <label class="editor-upload-button">
          Choose Image
          <input type="file"
                 accept=".png,.jpg,.jpeg,.gif,.webp,image/png,image/jpeg,image/gif,image/webp"
                 data-editor-target="uploadInput"
                 data-action="change->editor#upload">
        </label>
      </div>

      <div class="editor-upload-status" data-editor-target="status" aria-live="polite"></div>
      <div class="editor-upload-list" data-editor-target="uploadedList">
        <% if user_signed_in? %>
          <% @editor_images.each do |editor_image| %>
            <div class="editor-upload-row">
              <img src="<%= editor_image.url %>" alt="">
              <div>
                <strong><%= editor_image.original_filename %></strong>
                <code><%= editor_image.url %></code>
              </div>
              <button type="button" data-action="editor#insertImage" data-url="<%= editor_image.url %>">Insert</button>
              <button type="button" class="editor-upload-row__delete" data-action="editor#deleteImage" data-id="<%= editor_image.id %>">Delete</button>
            </div>
          <% end %>
        <% else %>
          <div class="editor-upload-empty">Log in to save uploaded images across refreshes.</div>
        <% end %>
      </div>

      <div class="editor-publish-meta">
        <input type="hidden" data-editor-target="publishedId">
        <input type="checkbox" data-editor-target="publicToggle" checked hidden>
        <div class="editor-publish-status" data-editor-target="publishStatus" aria-live="polite"></div>
        <div class="editor-public-link" data-editor-target="publicLink" hidden></div>
      </div>

      <div class="code-panels">
        <article class="code-panel code-panel--html">
          <div class="code-panel__header">
            <span>HTML</span>
            <small>Structure</small>
          </div>
          <textarea spellcheck="false"
                    data-editor-target="html"
                    data-default-value="<%= h(default_html) %>"
                    data-action="input->editor#queueRun"><%= default_html %></textarea>
        </article>

        <article class="code-panel code-panel--css">
          <div class="code-panel__header">
            <span>CSS</span>
            <small>Style</small>
          </div>
          <textarea spellcheck="false"
                    data-editor-target="css"
                    data-default-value="<%= h(default_css) %>"
                    data-action="input->editor#queueRun"><%= default_css %></textarea>
        </article>

        <article class="code-panel code-panel--js">
          <div class="code-panel__header">
            <span>JavaScript</span>
            <small>Behaviour</small>
          </div>
          <textarea spellcheck="false"
                    data-editor-target="js"
                    data-default-value="<%= h(default_js) %>"
                    data-action="input->editor#queueRun"><%= default_js %></textarea>
        </article>
      </div>
    </section>

    <section class="try-editor__right">
      <div class="preview-panel">
        <div class="preview-panel__header">
          <span>Live Preview</span>
          <small>Updates when you press Run</small>
        </div>
        <iframe title="CoffeeBean AI live preview" sandbox="allow-scripts allow-same-origin" data-editor-target="preview"></iframe>
      </div>
    </section>
  </main>
</div>
