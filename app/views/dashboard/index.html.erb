<% content_for :title, "Dashboard — CoffeeBean AI" %>
<% content_for :body_class, "page-scrollable" %>
<% name = current_user.email.split("@").first.tr("._-", " ").split.first.to_s.capitalize %>

<div class="dash-page">
  <%= render "shared/navbar" %>

  <div class="dash-body">
    <%# Greeting %>
    <div class="d-hello">
      <div>
        <h1>Welcome back, <span class="grad-text"><%= name %></span> 👋</h1>
        <p><%= @stats[:lessons].zero? ? "Pick a course below and finish your first lesson today." : "Keep going. Every lesson builds on the last one." %></p>
      </div>
      <%= link_to "Browse all courses →", courses_path, class: "btn btn-ghost" %>
    </div>

    <%# Stats %>
    <div class="d-stats">
      <div class="d-stat"><div class="d-stat-icon" style="background: rgba(139,92,246,.16)">📚</div><div><strong><%= @stats[:started] %></strong><span>Courses started</span></div></div>
      <div class="d-stat"><div class="d-stat-icon" style="background: rgba(59,130,246,.16)">✅</div><div><strong><%= @stats[:lessons] %></strong><span>Lessons completed</span></div></div>
      <div class="d-stat"><div class="d-stat-icon" style="background: rgba(16,185,129,.16)">🎯</div><div><strong><%= @stats[:correct] %></strong><span>Correct answers</span></div></div>
      <div class="d-stat"><div class="d-stat-icon" style="background: rgba(245,158,11,.16)">🏆</div><div><strong><%= @stats[:finished] %></strong><span>Courses finished</span></div></div>
    </div>

    <%# Continue learning %>
    <% if @in_progress.any? %>
      <section class="d-section">
        <div class="section-head"><div><h2>Continue learning</h2></div></div>
        <div class="d-continue">
          <% @in_progress.each do |course| %>
            <% prog = @progress[course.id] %>
            <div class="d-cont" style="--c: <%= course.ui_color %>">
              <div class="c-card-icon" aria-hidden="true"><%= course.icon %></div>
              <div class="d-cont-body">
                <h3><%= link_to course.title, course_lesson_path(course_slug: course.slug, id: prog[:next_lesson].id), class: "d-cont-link" %></h3>
                <p>Next: <%= prog[:next_lesson].title %></p>
                <div class="c-card-bar" aria-label="<%= prog[:pct] %>% complete"><span style="width: <%= prog[:pct] %>%"></span></div>
              </div>
              <span class="d-cont-go" aria-hidden="true">→</span>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <%# Featured original course %>
    <section class="d-section">
      <div class="d-feature">
        <div class="d-feature-icon" aria-hidden="true">🎓</div>
        <div>
          <span class="eyebrow">CoffeeBean AI Original</span>
          <h3>Beginner AI with Python</h3>
          <p>A visual 28-lesson course on AI basics, the types of AI, machine learning and hands-on Python.</p>
          <div class="c-card-bar" aria-label="<%= @ai_progress[:pct] %>% complete"><span style="width: <%= @ai_progress[:pct] %>%"></span></div>
          <p style="font-size: 12.5px; margin-top: 6px; color: var(--txt3)"><%= @ai_progress[:done] %> of <%= @ai_progress[:total] %> lessons done</p>
        </div>
        <%= link_to lesson_path([@ai_progress[:done] + 1, @ai_progress[:total]].min), class: "btn btn-primary btn-lg" do %>
          <%= @ai_progress[:done] > 0 ? "Continue" : "Start course" %> <span aria-hidden="true">→</span>
        <% end %>
      </div>
    </section>

    <%# Certificates %>
    <% if @certificates.any? %>
      <section class="d-section">
        <div class="section-head"><div><h2>Your certificates</h2><p>Click a certificate to open it, print it or share its link.</p></div></div>
        <div class="d-certs">
          <% @certificates.each do |cert| %>
            <%= render "certificates/thumb", certificate: cert %>
          <% end %>
        </div>
      </section>
    <% end %>

  </div>

  <%= render "shared/footer" %>
</div>
