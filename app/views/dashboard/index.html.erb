<% content_for :title, "Dashboard — AI Academy" %>
<% content_for :body_class, "page-scrollable" %>

<div class="dash-page">
  <%= render "shared/navbar" %>

  <div class="dash-body">

    <%# Welcome bar %>
    <div class="dash-welcome">
      <div>
        <h1 class="dash-greeting">Welcome back, <span><%= current_user.email.split("@").first.capitalize %></span> 👋</h1>
        <p class="dash-sub">Keep going — you're building the skills of the future.</p>
      </div>
      <div class="dash-score-card">
        <div class="score-num"><%= @total_correct %></div>
        <div class="score-label">Correct Answers</div>
        <div class="score-sub"><%= @total_attempts %> total attempts</div>
      </div>
    </div>

    <%# Featured AI Academy course %>
    <div class="dash-section">
      <h2 class="dash-section-title">Featured Course</h2>
      <div class="featured-course-card">
        <div class="fc-icon">🎓</div>
        <div class="fc-body">
          <div class="fc-tag">AI Academy Original</div>
          <h3 class="fc-title">Beginner AI with Python</h3>
          <p class="fc-desc">A comprehensive 28-lesson visual course covering AI fundamentals, types of AI, ML basics, and hands-on Python. Our most popular learning path.</p>
          <div class="fc-stats">
            <div class="fc-stat"><span class="fc-stat-num"><%= @ai_progress[:done] %></span><span class="fc-stat-label">/ 28 lessons done</span></div>
            <div class="fc-progress-wrap">
              <div class="fc-progress-bar"><div class="fc-progress-fill" style="width: <%= @ai_progress[:pct] %>%"></div></div>
              <span class="fc-pct"><%= @ai_progress[:pct] %>%</span>
            </div>
          </div>
        </div>
        <div class="fc-action">
          <%= link_to lesson_path(@ai_progress[:done] > 0 ? @ai_progress[:done] + 1 : 1), class: "fc-btn" do %>
            <%= @ai_progress[:done] > 0 ? "Continue" : "Start" %> Course →
          <% end %>
        </div>
      </div>
    </div>

    <%# All courses grid %>
    <div class="dash-section">
      <h2 class="dash-section-title">All Courses</h2>
      <div class="dash-courses-grid">
        <% @courses_with_progress.each do |cp| %>
          <div class="dash-course-card" style="--c: <%= cp[:course].color %>">
            <div class="dcc-header">
              <div class="dcc-icon"><%= cp[:course].icon %></div>
              <div class="dcc-title-wrap">
                <h3 class="dcc-title"><%= cp[:course].title %></h3>
                <p class="dcc-count"><%= cp[:done] %>/<%= cp[:total] %> lessons</p>
              </div>
              <div class="dcc-pct" style="color: var(--c)"><%= cp[:pct] %>%</div>
            </div>
            <div class="dcc-progress">
              <div class="dcc-bar"><div class="dcc-fill" style="width: <%= cp[:pct] %>%; background: var(--c)"></div></div>
            </div>
            <p class="dcc-desc"><%= truncate(cp[:course].description, length: 80) %></p>
            <div class="dcc-actions">
              <%= link_to course_path(cp[:course]), class: "dcc-btn-outline" do %>View Course<% end %>
              <%
                next_lesson = cp[:course].course_lessons.ordered.find do |l|
                  !current_user.course_progress_for(l.id)&.done?
                end || cp[:course].course_lessons.ordered.first
              %>
              <%= link_to course_lesson_path(course_slug: cp[:course].slug, id: next_lesson.id),
                    class: "dcc-btn-primary", style: "background: var(--c)" do %>
                <%= cp[:done] > 0 ? "Continue" : "Start" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

  </div>

  <%= render "shared/footer" %>
</div>
