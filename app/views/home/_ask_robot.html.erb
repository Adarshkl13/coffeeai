<%# Home page: a small robot fixed in the bottom-right corner, with a speech bubble. Clicking it opens Ask AI.
    Pure CSS animation (design.css "Ask robot"); it stops moving for people who turn off motion. %>
<%= link_to ask_path, class: "ask-robot", aria: { label: "Ask CoffeeBean AI a question" } do %>
  <span class="ask-robot-bubble" aria-hidden="true">Have a question? <b>Ask AI</b></span>
  <span class="ask-robot-bot" aria-hidden="true">
    <svg viewBox="0 0 120 130" width="88" height="95">
      <defs>
        <linearGradient id="arBody" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f5f3ff"/><stop offset="1" stop-color="#c4b5fd"/></linearGradient>
        <linearGradient id="arFace" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1e1b4b"/><stop offset="1" stop-color="#312e81"/></linearGradient>
        <linearGradient id="arGlow" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#22d3ee"/><stop offset="1" stop-color="#818cf8"/></linearGradient>
      </defs>
      <ellipse class="ar-shadow" cx="60" cy="124" rx="28" ry="4" fill="rgba(76,29,149,.25)"/>
      <g class="ar-float">
        <line x1="60" y1="14" x2="60" y2="26" stroke="#a78bfa" stroke-width="3" stroke-linecap="round"/>
        <circle class="ar-antenna" cx="60" cy="10" r="6" fill="url(#arGlow)"/>
        <rect x="10" y="46" width="10" height="22" rx="5" fill="#a78bfa"/>
        <rect x="100" y="46" width="10" height="22" rx="5" fill="#a78bfa"/>
        <rect x="18" y="24" width="84" height="66" rx="26" fill="url(#arBody)" stroke="#8b5cf6" stroke-width="2"/>
        <rect x="28" y="36" width="64" height="40" rx="18" fill="url(#arFace)"/>
        <g class="ar-eyes" fill="#67e8f9">
          <ellipse cx="47" cy="55" rx="6" ry="7"/><ellipse cx="73" cy="55" rx="6" ry="7"/>
        </g>
        <path d="M51 66 Q60 72 69 66" fill="none" stroke="#67e8f9" stroke-width="3" stroke-linecap="round"/>
        <rect x="38" y="92" width="44" height="24" rx="12" fill="url(#arBody)" stroke="#8b5cf6" stroke-width="2"/>
        <circle cx="60" cy="104" r="5" fill="url(#arGlow)"/>
        <g class="ar-wave"><rect x="96" y="70" width="10" height="26" rx="5" fill="#a78bfa" transform="rotate(-35 101 72)"/></g>
      </g>
    </svg>
  </span>
<% end %>
