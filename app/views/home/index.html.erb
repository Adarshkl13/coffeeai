<% content_for :title, "CoffeeBean AI: Learn AI with Hands-On Lessons and Podcasts" %>
<% content_for :head do %>
  <%# Tells Google the site name and logo to show in search results. %>
  <script type="application/ld+json"><%= raw({
    "@context" => "https://schema.org",
    "@graph" => [
      { "@type" => "WebSite", "@id" => "#{site_url}/#website", "name" => "CoffeeBean AI", "alternateName" => "CoffeeBeanAI", "url" => "#{site_url}/" },
      { "@type" => "Organization", "@id" => "#{site_url}/#org", "name" => "CoffeeBean AI", "url" => "#{site_url}/",
        "logo" => "#{site_url}/icon-1024.png", "description" => ApplicationHelper::DEFAULT_DESCRIPTION }
    ]
  }.to_json.gsub("</", "<\\/")) %></script>
<% end %>
<% content_for :body_class, "page-scrollable" %>


<div class="home-page">
  <%= render "shared/navbar" %>

  <%# ── Hero ─────────────────────────────────────────────── %>
  <section class="h-hero">
    <div class="wrap h-hero-grid h-hero-podcast">
      <div>
        <span class="h-badge"><b>New</b> AI courses for HR, software testers and managers</span>
        <h1 class="h-title">Learn AI, one <span class="grad-text">coffee break</span> at a time</h1>
        <p class="h-sub">Learn how AI works and how to use it well, from your first lesson to your own AI app.</p>
        <div class="h-cta">
          <%= link_to new_user_registration_path, class: "btn btn-primary btn-lg" do %>Get started <span aria-hidden="true">→</span><% end %>
          <%= link_to "Explore courses", "#courses", class: "btn btn-ghost btn-lg" %>
        </div>
      </div>

      <%= render "home/podcast" %>
      <%= render "home/infographics" %>
    </div>
  </section>

  <%# ── Courses ──────────────────────────────────────────── %>
  <%# ── Two live lesson activities, before the courses ──── %>
  <%= render "home/activities" %>

  <%# ── For professionals: job areas, then AI at work in a real job ── %>
  <%= render "home/professions", courses: @courses %>
  <%= render "home/role_demo", courses: @courses %>

  <section class="h-section h-section-alt" id="courses">
    <div class="wrap" data-controller="course-filter" data-course-filter-default-value="featured">
      <div class="section-head">
        <div>
          <span class="eyebrow">Courses</span>
          <h2>Build skills that stand out</h2>
          <p>Pick a topic, or search for what you want to learn.</p>
        </div>
      </div>
      <%= render "shared/course_filter", categories: @categories, total: @courses.size, featured: true %>
      <div class="c-grid">
        <%= render "shared/original_course_card", hidden: true %>
        <% @courses.each do |course| %>
          <%= render "shared/course_card", course: course, lessons: course.course_lessons.size, hidden: !course.featured? %>
        <% end %>
      </div>
    </div>
  </section>

  <%# ── Learning path and bento grid (they replaced "How it works" and "Why CoffeeBean AI") ── %>
  <%= render "home/bento", courses: @courses %>
  <%= render "home/path" %>
  <%= render "home/stories" %>

  <%# ── Blog ─────────────────────────────────────────────── %>
  <% if @blog_posts.any? %>
    <section class="h-section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow">From the blog</span>
            <h2>Step-by-step guides</h2>
          </div>
          <%= link_to "View all posts →", blogs_path, class: "dash-section-link" %>
        </div>
        <div class="blog-grid">
          <%= render partial: "blogs/card", collection: @blog_posts, as: :post %>
        </div>
      </div>
    </section>
  <% end %>

  <%# ── Call to action ───────────────────────────────────── %>
  <section class="h-section" style="padding-top: 8px">
    <div class="wrap">
      <div class="h-cta-band">
        <h2>Ready to start learning?</h2>
        <p>Choose a plan and start your first lesson in the next five minutes.</p>
        <div class="h-cta">
          <%= link_to "See plans", pricing_path, class: "btn btn-primary btn-lg" %>
          <%= link_to "Log in", new_user_session_path, class: "btn btn-ghost btn-lg" %>
        </div>
      </div>
    </div>
  </section>

  <%= render "home/ask_robot" %>
  <%= render "shared/footer" %>
</div>
