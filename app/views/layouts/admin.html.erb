<!DOCTYPE html>
<html data-theme="dark">
  <head>
    <title>Admin — CoffeeBean AI</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap">
    <meta name="theme-color" content="#0a0a1c">
    <%= render "shared/theme_head" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin-body">
    <nav class="admin-nav">
      <div class="admin-nav-inner">
        <div class="admin-nav-left">
          <%= link_to admin_root_path, class: "admin-logo" do %>
            <span>CoffeeBean AI</span>
            <span class="admin-badge">Admin</span>
          <% end %>
          <%= link_to "Dashboard", admin_root_path, class: "admin-nav-link" %>
          <%= link_to "Users", admin_users_path, class: "admin-nav-link" %>
          <%= link_to "Courses", admin_courses_path, class: "admin-nav-link" %>
        </div>
        <div class="admin-nav-right">
          <%= render "shared/theme_toggle" %>
          <%= link_to "← Back to Site", root_path, class: "admin-nav-link" %>
          <%= link_to "Sign Out", destroy_user_session_path, class: "admin-nav-link", data: { turbo_method: :delete } %>
        </div>
      </div>
    </nav>
    <main class="admin-main">
      <% if notice.present? %>
        <div class="flash flash-notice"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="flash flash-alert"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
