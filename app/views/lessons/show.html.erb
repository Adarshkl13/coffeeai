<% content_for :title, "#{@lesson[:number]} #{@lesson[:title]} — CoffeeBean AI" %>
<% content_for :noindex, "1" %>

<div class="app-shell" data-controller="lesson">

  <%# ─── Mobile top bar ──────────────────────────────────────────── %>
  <header class="mobile-bar">
    <button class="hamburger" data-action="click->lesson#toggleSidebar" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
    <%= link_to (user_signed_in? ? dashboard_path : root_path), class: "mobile-logo" do %>CoffeeBean <strong>AI</strong><% end %>
    <%= render "shared/theme_toggle", extra_class: "theme-toggle-mobile" %>
    <div class="mobile-user">
      <%= link_to destroy_user_session_path, method: :delete, class: "logout-link", data: { turbo_method: :delete } do %>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      <% end %>
    </div>
  </header>

  <%# ─── Sidebar overlay (mobile) ──────────────────────────────── %>
  <div class="sidebar-overlay" data-action="click->lesson#toggleSidebar" data-lesson-target="overlay"></div>

  <%# ─── LEFT SIDEBAR ──────────────────────────────────────────── %>
  <aside class="sidebar" data-lesson-target="sidebar">

    <div class="sidebar-logo">
      <%= link_to (user_signed_in? ? dashboard_path : root_path), class: "sidebar-logo-link", aria: { label: "CoffeeBean AI home" } do %>
        <div class="logo-icon-wrap">
          <%= render "shared/logo_mark", size: 20 %>
        </div>
        <span class="logo-text">CoffeeBean <strong>AI</strong></span>
      <% end %>
      <%= render "shared/theme_toggle", extra_class: "theme-toggle-sidebar" %>
    </div>

    <div class="course-card">
      <p class="course-name">Beginner AI with Python</p>
      <div class="progress-bar-track">
        <div class="progress-bar-fill" style="width: <%= @progress_pct %>%"></div>
      </div>
      <p class="progress-label"><%= @progress_pct %>% Complete</p>
    </div>

    <div class="nav-section-label">COURSE CONTENT</div>

    <nav class="course-nav">
      <% @modules_with_lessons.each do |mod| %>
        <% is_active_module = mod[:lessons].any? { |l| l[:id] == @lesson[:id] } %>
        <div class="module-block">
          <button class="module-toggle <%= is_active_module ? 'open' : '' %>"
                  data-action="click->lesson#toggleModule"
                  data-module="<%= mod[:id] %>">
            <span class="module-title">Module <%= mod[:id] %>: <%= mod[:name] %></span>
            <span class="module-meta">
              <span class="module-count"><%= mod[:completed] %>/<%= mod[:lessons].size %></span>
              <svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </button>

          <ul class="lesson-list <%= is_active_module ? 'visible' : '' %>" id="module-lessons-<%= mod[:id] %>">
            <% mod[:lessons].each do |lesson| %>
              <% is_current  = lesson[:id] == @lesson[:id] %>
              <% is_done     = %w[completed skipped].include?(lesson[:progress_status]) %>
              <% is_skipped  = lesson[:progress_status] == "skipped" %>
              <li>
                <% if lesson[:locked] %>
                  <span class="lesson-link locked" title="<%= lesson[:pro] ? "Needs a plan" : "Complete previous lesson to unlock" %>">
                    <span class="lesson-status-icon">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                      </svg>
                    </span>
                    <span class="lesson-link-title"><%= lesson[:number] %> <%= lesson[:pro] ? pro_blur(lesson[:title]) : lesson[:title] %></span>
                  </span>
                <% else %>
                  <%= link_to lesson_path(lesson[:id]),
                        class: "lesson-link #{is_current ? 'current' : ''} #{is_done ? 'done' : ''} #{is_skipped ? 'skipped-item' : ''}" do %>
                    <span class="lesson-status-icon">
                      <% if is_done && !is_current %>
                        <% if is_skipped %>
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5">
                            <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        <% else %>
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="3">
                            <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        <% end %>
                      <% elsif is_current %>
                        <span class="dot-active"></span>
                      <% else %>
                        <span class="dot-empty"></span>
                      <% end %>
                    </span>
                    <span class="lesson-link-title"><%= lesson[:number] %> <%= lesson[:title] %></span>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </nav>

    <div class="sidebar-footer">
      <div class="user-bar">
        <div class="user-avatar"><%= current_user.email[0].upcase %></div>
        <div class="user-info">
          <p class="user-email"><%= current_user.email %></p>
          <%= link_to "Sign out", destroy_user_session_path,
                method: :delete,
                class: "sign-out-link",
                data: { turbo_method: :delete } %>
        </div>
      </div>

      <% if @certificate %>
        <div class="crt-side">
          <p class="crt-side-label">🏆 Your certificate</p>
          <%= render "certificates/thumb", certificate: @certificate, caption: false %>
        </div>
      <% elsif @next_lesson.nil? %><%# the "how to earn it" note shows on the last lesson only %>
        <div class="certificate-card">
          <span class="cert-icon">🏆</span>
          <div>
            <p class="cert-title">Course Certificate</p>
            <p class="cert-desc">Complete every lesson to earn it. Skipped lessons do not count.</p>
          </div>
        </div>
      <% end %>
    </div>

  </aside>

  <%# ─── MAIN LESSON AREA ───────────────────────────────────────── %>
  <main class="main-content">

    <div class="breadcrumb">
      <span>Module <%= @lesson[:module_id] %></span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Lesson <%= @lesson[:number] %></span>
      <% if @current_progress&.completed? %>
        <span class="status-pill pill-done">Completed</span>
      <% elsif @current_progress&.skipped? %>
        <span class="status-pill pill-skip">Skipped</span>
      <% elsif @current_progress&.in_progress? %>
        <span class="status-pill pill-prog">In Progress</span>
      <% end %>
    </div>

    <div class="lesson-scroll">
      <%# Module podcast (Cloudflare R2), on the first lesson of each module %>
      <% if @lesson[:number].end_with?(".1") && (ep = CoursePodcast.episodes("beginner-ai-python").find { |e| e.module == @lesson[:module_id] }) %>
        <%= render "courses/podcast", episodes: [ep], locked: !full_access?, heading: "Listen to this module",
                   intro: "A short podcast about this module, in six languages. Listen before you start, or while you travel." %>
      <% end %>

      <%# Lesson image %>
      <div class="lesson-image-wrap">
        <%= image_tag @lesson[:image], class: "lesson-image", alt: "#{@lesson[:number]} #{@lesson[:title]}" %>
      </div>

      <%# Lesson body and code editor (lib/beginner_ai_python_content.rb), like the other courses %>
      <% content = BeginnerAiPythonContent::LESSONS[@lesson[:id]] %>
      <% if content %>
        <div class="lesson-rich-body">
          <h1 class="lesson-rich-title"><%= @lesson[:title] %></h1>
          <%= raw content[:body] %>
        </div>
        <%= render "lessons/python_editor", code: content[:starter_code] if content[:starter_code].present? %>
      <% end %>
    </div>

    <div class="lesson-nav-bar">
      <% if @prev_lesson %>
        <%= link_to lesson_path(@prev_lesson[:id]), class: "nav-btn nav-prev" do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Previous Lesson
        <% end %>
      <% else %>
        <span class="nav-btn nav-prev disabled">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Previous Lesson
        </span>
      <% end %>

      <% if @next_lesson %>
        <% next_prog = current_user.progress_for(@next_lesson[:id]) %>
        <% if @current_progress&.done? || true %>
          <%= link_to lesson_path(@next_lesson[:id]), class: "nav-btn nav-next" do %>
            Next Lesson
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          <% end %>
        <% end %>
      <% else %>
        <span class="nav-btn nav-next complete">🎉 Course Complete!</span>
      <% end %>
    </div>

  </main>

  <%# ─── RIGHT EXERCISE PANEL ──────────────────────────────────── %>
  <aside class="right-panel">

    <%# Hidden forms for complete/skip actions %>
    <%= form_with url: complete_lesson_path(@lesson[:id]), method: :post, id: "complete-form", data: { turbo: false } do |f|
      f.hidden_field :_confirmed, value: "1"
    end %>
    <%= form_with url: skip_lesson_path(@lesson[:id]), method: :post, id: "skip-form", data: { turbo: false } do |f|
      f.hidden_field :_confirmed, value: "1"
    end %>

    <div class="exercise-panel">

      <div class="exercise-heading">
        <div class="exercise-icon-wrap">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <path d="M9 9h6M9 12h6M9 15h4" stroke-linecap="round"/>
          </svg>
        </div>
        <span class="exercise-id-label">Exercise <%= @lesson[:exercise_id] %></span>
      </div>

      <% if @current_progress&.done? %>
        <%# ── Already completed/skipped — show result ── %>
        <div class="already-done-box">
          <% if @current_progress.completed? %>
            <div class="done-icon">✓</div>
            <p class="done-title">Lesson Completed!</p>
            <p class="done-desc">You answered this exercise correctly.</p>
          <% else %>
            <div class="done-icon skip">→</div>
            <p class="done-title">Lesson Skipped</p>
            <p class="done-desc">You skipped this lesson's exercise.</p>
          <% end %>
          <% if @next_lesson %>
            <%= link_to lesson_path(@next_lesson[:id]), class: "next-up-btn" do %>
              Continue to <%= @next_lesson[:number] %>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            <% end %>
          <% end %>
        </div>

      <% else %>
        <%# ── Active exercise ── %>
        <p class="exercise-question"><%= raw @lesson[:question] %></p>

        <div class="options-list" data-lesson-target="optionsList">
          <% @lesson[:options].each_with_index do |opt, i| %>
            <% val = @lesson[:exercise_type] == "multiple_choice" ? ('A'.ord + i).chr : opt %>
            <label class="option-row" data-value="<%= val %>">
              <input type="radio" name="ex_<%= @lesson[:id] %>" value="<%= val %>"
                     data-action="change->lesson#pickOption">
              <span class="option-radio"></span>
              <span class="option-text"><%= opt %></span>
            </label>
          <% end %>
        </div>

        <div class="exercise-feedback hidden" data-lesson-target="feedback"></div>

        <div class="exercise-actions">
          <button class="check-btn" data-action="click->lesson#checkAnswer"
                  data-correct="<%= CGI.escapeHTML(@lesson[:correct_answer].to_s) %>">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Check Answer
          </button>

          <button class="skip-btn" data-action="click->lesson#skipLesson">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Skip Lesson
          </button>
        </div>

        <p class="skip-note">Skipping unlocks the next lesson but won't count as completed.</p>
      <% end %>

    </div>

    <%# ─── Notes section ──────────────────────────────────────── %>
    <div class="notes-section">
      <div class="notes-header">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
        </svg>
        <span>My Notes</span>
      </div>
      <textarea class="notes-area"
                placeholder="Take notes on this lesson…"
                data-lesson-target="notesArea"
                data-action="input->lesson#saveNotes"></textarea>
    </div>

  </aside>

</div>
