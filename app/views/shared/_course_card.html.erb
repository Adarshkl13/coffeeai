<%#
  A course card. Locals:
    course   – the Course
    lessons  – number of lessons
    progress – optional { done:, pct:, next_lesson: } for a signed-in learner
  Cards carry data attributes the course-filter controller uses for tabs and search.
%>
<%
  progress = user_signed_in? ? local_assigns[:progress] : nil   # visitors have no progress to show
  started = progress && progress[:done].to_i > 0
  primary_path =
    if !user_signed_in? then course_path(course)                  # course pages are public
    elsif progress && progress[:next_lesson] then course_lesson_path(course_slug: course.slug, id: progress[:next_lesson].id)
    else course_path(course)
    end
  primary_label = !user_signed_in? ? "Start" : (started ? (progress[:pct] == 100 ? "Review" : "Continue") : "Start")
%>
<article class="c-card" style="--c: <%= course.ui_color %>"
         data-course-filter-target="card"
         data-category="<%= course.category_name %>"
         data-featured="<%= course.featured? %>"<%= " hidden" if local_assigns[:hidden] %>
         data-search="<%= [course.title, course.category_name, course.description].join(' ').downcase %>">
  <div class="c-card-top">
    <div class="c-card-icon" aria-hidden="true"><%= course.icon %></div>
    <div class="c-card-heading">
      <span class="c-card-cat"><%= course.category_name %></span>
      <h3 class="c-card-title"><%= link_to course.title, course_path(course) %></h3>
    </div>
  </div>
  <p class="c-card-desc"><%= truncate(course.description, length: 105, separator: " ") %></p>
  <div class="c-card-meta">
    <% if progress %>
      <span class="c-card-pct"><%= progress[:pct] %>%</span>
    <% else %>
      <span><%= pluralize(lessons, "lesson") %></span>
    <% end %>
  </div>
  <% if progress %>
    <div class="c-card-bar" role="progressbar" aria-valuenow="<%= progress[:pct] %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= course.title %> progress">
      <span style="width: <%= progress[:pct] %>%"></span>
    </div>
  <% end %>
  <div class="c-card-actions">
    <% if user_signed_in? %>
      <%= link_to "Details", course_path(course), class: "btn btn-ghost btn-sm" %>
    <% end %>
    <%= link_to primary_path, class: "btn btn-course btn-sm" do %><%= primary_label %> <span aria-hidden="true">→</span><% end %>
  </div>
</article>
