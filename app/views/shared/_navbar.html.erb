<nav class="site-nav">
  <div class="nav-inner">
    <div class="nav-left">
      <%= link_to root_path, class: "nav-logo" do %>
        <div class="nav-logo-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2a10 10 0 1 0 10 10" stroke-linecap="round"/>
            <circle cx="12" cy="12" r="3"/>
            <path d="M12 2v3M12 19v3M2 12h3M19 12h3" stroke-linecap="round"/>
          </svg>
        </div>
        <span>AI <strong>Academy</strong></span>
      <% end %>
      <div class="nav-links">
        <%= link_to "Editor", editor_path, class: "nav-link" %>
        <%= link_to "Courses", courses_path, class: "nav-link" if user_signed_in? %>
        <%= link_to "Dashboard", dashboard_path, class: "nav-link" if user_signed_in? %>
        <%= link_to "AI Academy Course", lesson_path(1), class: "nav-link nav-link-special" if user_signed_in? %>
        <% if current_user&.admin? %>
          <%= link_to "Admin", admin_root_path, class: "nav-link nav-link-admin" %>
        <% end %>
      </div>
    </div>

    <div class="nav-right">
      <% if user_signed_in? %>
        <div class="nav-user">
          <div class="nav-avatar"><%= current_user.email[0].upcase %></div>
          <%= link_to destroy_user_session_path, method: :delete, class: "nav-signout",
                data: { turbo_method: :delete } do %>
            Sign out
          <% end %>
        </div>
      <% else %>
        <%= link_to "Log in", new_user_session_path, class: "nav-login" %>
        <%= link_to "Sign up", new_user_registration_path, class: "nav-signup" %>
      <% end %>
    </div>
  </div>
</nav>
