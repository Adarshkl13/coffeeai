<%
  nav_items = []
  nav_items << ["Dashboard", dashboard_path] if user_signed_in?
  nav_items << ["Courses", user_signed_in? ? courses_path : root_path(anchor: "courses")]
  nav_items << ["Ask AI", ask_path]
  nav_items << ["Editor", editor_path]
  nav_items << ["Pricing", pricing_path] unless user_signed_in? && current_user.member?
  # A link is active on its own page and on pages below it (/courses/python is under Courses).
  active = lambda do |path|
    base = path.split("#").first
    base = "/lessons" if base.start_with?("/lessons/")
    base.present? && base != "/" && (request.path == base || request.path.start_with?("#{base}/"))
  end
%>
<nav class="site-nav" data-controller="nav-menu">
  <div class="nav-inner">
    <div class="nav-left">
      <%= link_to root_path, class: "nav-logo", aria: { label: "CoffeeBean AI home" } do %>
        <div class="nav-logo-icon">
          <%= render "shared/logo_mark", size: 18 %>
        </div>
        <span>CoffeeBean <strong>AI</strong></span>
      <% end %>
      <div class="nav-links" data-nav-menu-target="menu">
        <% nav_items.each do |label, path| %>
          <%= link_to label, path, class: ["nav-link", ("is-active" if active.(path))].compact.join(" "),
                aria: { current: (active.(path) ? "page" : nil) } %>
        <% end %>
        <% if current_user&.admin? %>
          <%= link_to "Admin", admin_root_path, class: "nav-link nav-link-admin" %>
        <% end %>
        <div class="nav-links-auth">
          <% if user_signed_in? %>
            <%= link_to "Account settings", edit_user_registration_path, class: "nav-link" %>
            <%= link_to "Log out", destroy_user_session_path, class: "nav-link", data: { turbo_method: :delete } %>
          <% else %>
            <%= link_to "Log in", new_user_session_path, class: "nav-link" %>
            <%= link_to "Sign up", new_user_registration_path, class: "btn btn-primary btn-sm" %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="nav-right">
      <% if user_signed_in? %>
        <div class="nav-user">
          <%= link_to edit_user_registration_path, class: "nav-avatar", title: "Account settings (#{current_user.email})", aria: { label: "Account settings" } do %><%= current_user.email[0].upcase %><% end %>
          <%= link_to "Log out", destroy_user_session_path, class: "nav-signout", data: { turbo_method: :delete } %>
        </div>
      <% else %>
        <%= link_to "Log in", new_user_session_path, class: "nav-login" %>
        <%= link_to "Sign up", new_user_registration_path, class: "btn btn-primary btn-sm nav-signup" %>
      <% end %>
      <%= render "shared/theme_toggle" %>
      <button type="button" class="nav-toggle" data-action="nav-menu#toggle" data-nav-menu-target="button"
              aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>
