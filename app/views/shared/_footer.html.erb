<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="footer-logo">
        <div class="footer-logo-icon">
          <%= render "shared/logo_mark", size: 16 %>
        </div>
        <span>CoffeeBean <strong>AI</strong></span>
      </div>
      <p class="footer-tagline">Learn AI, one coffee break at a time.</p>
    </div>

    <div class="footer-cols">
      <div class="footer-col">
        <p class="footer-col-title">Courses</p>
        <ul>
          <li><%= link_to "HTML & CSS",        course_path("html-css") %></li>
          <li><%= link_to "JavaScript",        course_path("javascript") %></li>
          <li><%= link_to "Python",            course_path("python") %></li>
          <li><%= link_to "Machine Learning",  course_path("machine-learning") %></li>
          <li><%= link_to "Artificial Intelligence", course_path("artificial-intelligence") %></li>
          <li><%= link_to "Data Science",      course_path("data-science") %></li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-col-title">Platform</p>
        <ul>
          <li><%= link_to "Dashboard", dashboard_path %></li>
          <% if user_signed_in? %><li><%= link_to "Account settings", edit_user_registration_path %></li><% end %>
          <li><%= link_to "Ask AI", ask_path %></li>
          <li><%= link_to "Blog", blogs_path %></li>
          <li><%= link_to "Beginner AI with Python", lesson_path(1) %></li>
          <li><%= link_to "Sign up", new_user_registration_path %></li>
          <li><%= link_to "Log in", new_user_session_path %></li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-col-title">Company</p>
        <ul>
          <li><%= link_to "About", about_path %></li>
          <li><%= link_to "Contact", contact_path %></li>
          <li><%= link_to "Pricing", pricing_path %></li>
          <li><%= link_to "Privacy Policy", privacy_path %></li>
          <li><%= link_to "Terms of Service", terms_path %></li>
          <li><%= link_to "Refund Policy", refund_policy_path %></li>
          <li><%= link_to "Delivery Policy", delivery_policy_path %></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; <%= Time.current.year %> CoffeeBean AI, operated by <%= COMPANY[:legal_name] %>. All rights reserved.</p>
  </div>
</footer>
