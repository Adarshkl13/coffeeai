<% content_for :title, "Choose a new password — CoffeeBean AI" %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">
      <div class="auth-logo-icon"><%= render "shared/logo_mark", size: 24 %></div>
      <span class="auth-logo-text">CoffeeBean <strong>AI</strong></span>
    </div>

    <h1 class="auth-title">Choose a new password</h1>
    <p class="auth-subtitle">Type it twice so we know it is right.</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="field-group">
        <%= f.label :password, class: "field-label" do %>
          New password<% if @minimum_password_length %> <span class="field-hint">(<%= @minimum_password_length %>+ characters)</span><% end %>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "field-input" %>
      </div>

      <div class="field-group">
        <%= f.label :password_confirmation, "Confirm new password", class: "field-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field-input" %>
      </div>

      <%= f.submit "Save new password", class: "auth-submit-btn" %>
    <% end %>

    <p class="auth-switch">
      <%= link_to "Back to sign in", new_session_path(resource_name), class: "auth-switch-link" %>
    </p>
  </div>
</div>
