<% content_for :title, "Sign up — CoffeeBean AI" %>
<% content_for :description, "Create your CoffeeBean AI account and start learning AI with short, hands-on lessons and podcasts." %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">
      <div class="auth-logo-icon">
        <%= render "shared/logo_mark", size: 24 %>
      </div>
      <span class="auth-logo-text">CoffeeBean <strong>AI</strong></span>
    </div>

    <h1 class="auth-title">Create your account</h1>
    <p class="auth-subtitle">Start your AI learning journey today</p>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field-group">
        <%= f.label :email, "Email address", class: "field-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "field-input", placeholder: "you@example.com" %>
      </div>

      <div class="field-group">
        <%= f.label :password, class: "field-label" do %>
          Password
          <% if @minimum_password_length %>
            <span class="field-hint">(<%= @minimum_password_length %>+ characters)</span>
          <% end %>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password",
              class: "field-input", placeholder: "••••••••" %>
      </div>

      <div class="field-group">
        <%= f.label :password_confirmation, "Confirm password", class: "field-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "field-input", placeholder: "••••••••" %>
      </div>

      <%= f.submit "Create account", class: "auth-submit-btn" %>
      <p class="auth-terms">By creating an account, you agree to our <%= link_to "Terms of Service", terms_path %> and <%= link_to "Privacy Policy", privacy_path %>.</p>
    <% end %>

    <p class="auth-switch">
      Already have an account?
      <%= link_to "Log in", new_session_path(resource_name), class: "auth-switch-link" %>
    </p>
  </div>
</div>
