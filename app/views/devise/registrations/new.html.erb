<% content_for :title, "Sign Up — AI Academy" %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">
      <div class="auth-logo-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2a10 10 0 1 0 10 10" stroke-linecap="round"/>
          <circle cx="12" cy="12" r="3"/>
          <path d="M12 2v3M12 19v3M2 12h3M19 12h3" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="auth-logo-text">AI <strong>Academy</strong></span>
    </div>

    <h1 class="auth-title">Create your account</h1>
    <p class="auth-subtitle">Start your AI learning journey today — it's free</p>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field-group">
        <%= f.label :email, "Email address", class: "field-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "field-input", placeholder: "you@example.com" %>
      </div>

      <div class="field-group">
        <%= f.label :password, class: "field-label" do %>
          Password
          <% if @minimum_password_length %>
            <span class="field-hint">(<%= @minimum_password_length %>+ characters)</span>
          <% end %>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password",
              class: "field-input", placeholder: "••••••••" %>
      </div>

      <div class="field-group">
        <%= f.label :password_confirmation, "Confirm password", class: "field-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "field-input", placeholder: "••••••••" %>
      </div>

      <%= f.submit "Create account", class: "auth-submit-btn" %>
    <% end %>

    <p class="auth-switch">
      Already have an account?
      <%= link_to "Sign in", new_session_path(resource_name), class: "auth-switch-link" %>
    </p>
  </div>
</div>
