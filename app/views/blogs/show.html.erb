<% content_for :title, "#{@post.title} — CoffeeBean AI Blog" %>
<% content_for :description, @post.subtitle %>
<% content_for :og_type, "article" %>
<% content_for :body_class, "page-scrollable" %>
<% content_for :head do %>
  <%# Article (and FAQ) details for Google. %>
  <% data = [{ "@context" => "https://schema.org", "@type" => "Article", "headline" => @post.title, "description" => @post.subtitle,
               "image" => site_url + @post.image_url_path(@post.cover_image), "datePublished" => @post.published_on.iso8601,
               "author" => { "@type" => "Organization", "name" => "CoffeeBean AI", "url" => "#{site_url}/" },
               "publisher" => { "@type" => "Organization", "name" => "CoffeeBean AI", "logo" => { "@type" => "ImageObject", "url" => "#{site_url}/icon-1024.png" } },
               "mainEntityOfPage" => site_url + blog_path(@post) }]
     if @post.faqs.any?
       data << { "@context" => "https://schema.org", "@type" => "FAQPage",
                 "mainEntity" => @post.faqs.map { |f| { "@type" => "Question", "name" => f[:question], "acceptedAnswer" => { "@type" => "Answer", "text" => f[:answer] } } } }
     end %>
  <% data.each do |d| %><script type="application/ld+json"><%= raw d.to_json.gsub("</", "<\\/") %></script><% end %>
<% end %>

<div class="dash-page">
  <%= render "shared/navbar" %>

  <div class="dash-body">
    <article class="blog-article" style="--c: <%= @post.color %>">
      <nav class="blog-crumbs">
        <%= link_to user_signed_in? ? "Dashboard" : "Home", user_signed_in? ? dashboard_path : root_path %> › <%= link_to "Blog", blogs_path %> › <span><%= @post.tag %></span>
      </nav>

      <header class="blog-article-head">
        <span class="blog-tag"><%= @post.icon %> <%= @post.tag %></span>
        <h1 class="blog-article-title"><%= @post.title %></h1>
        <p class="blog-article-sub"><%= @post.subtitle %></p>
        <p class="blog-article-meta"><%= @post.published_on.strftime("%-d %B %Y") %> · <%= @post.reading_minutes %> min read</p>
      </header>

      <div class="blog-prose">
        <%= raw @post.body_html %>
      </div>
    </article>

    <% if @other_posts.any? %>
      <section class="blog-more">
        <h2 class="dash-section-title">More from the blog</h2>
        <div class="blog-grid">
          <%= render partial: "blogs/card", collection: @other_posts, as: :post %>
        </div>
      </section>
    <% end %>
  </div>

  <%= render "shared/footer" %>
</div>
