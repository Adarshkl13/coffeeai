require_relative "../mysql_content"

namespace :content do
  desc "Create MySQL course and populate all 20 lessons"
  task mysql: :environment do
    course = Course.find_or_create_by!(slug: "mysql") do |c|
      c.title       = "MySQL"
      c.description = "MySQL powers over 50% of the web's databases. Learn MySQL-specific features: AUTO_INCREMENT, CONCAT, DATE_FORMAT, GROUP_CONCAT, stored procedures, triggers, transactions, indexes, JSON support, and window functions."
      c.color       = "#fb923c"
      c.icon        = "🐬"
      c.position    = 11
      c.published   = true
    end
    puts "Course: #{course.title}"

    titles = {
      1  => "Introduction to MySQL",         2  => "MySQL Data Types",
      3  => "AUTO_INCREMENT and Keys",        4  => "MySQL String Functions",
      5  => "MySQL Date & Time Functions",    6  => "Aggregate Functions & GROUP_CONCAT",
      7  => "MySQL JOINs",                    8  => "Subqueries and EXISTS",
      9  => "Views",                          10 => "Stored Procedures",
      11 => "Stored Functions",              12 => "Triggers",
      13 => "Transactions",                  14 => "Indexes and EXPLAIN",
      15 => "User Management and Security",  16 => "MySQL JSON Support",
      17 => "Window Functions",              18 => "FULLTEXT Search",
      19 => "MySQL with Applications",       20 => "MySQL Review"
    }

    exercises = {
      1  => { type: "multiple_choice", q: "What key difference between MySQL and SQLite does the lesson highlight?",
              opts: ["A) MySQL runs as a server that clients connect to; SQLite is a file", "B) SQLite runs as a background server; MySQL is stored as one file", "C) MySQL is a document (NoSQL) database, while SQLite is relational"], ans: "A" },
      2  => { type: "true_false",      q: "FLOAT is the recommended type for storing prices, because it uses less storage than DECIMAL.",
              opts: ["True", "False"], ans: "False" },
      3  => { type: "multiple_choice", q: "Which MySQL function returns the most recent ID generated by AUTO_INCREMENT on your connection?",
              opts: ["A) NEXT_ID()", "B) LAST_INSERT_ID()", "C) AUTO_ID()"], ans: "B" },
      4  => { type: "multiple_choice", q: "With MySQL's default settings, what happens with SELECT 'a' || 'b';?",
              opts: ["A) It returns 'ab', just like PostgreSQL", "B) It raises a syntax error because || does not exist in MySQL", "C) || is treated as logical OR, so it does not return 'ab'"], ans: "C" },
      5  => { type: "multiple_choice", q: "Which MySQL function formats a date as a custom string?",
              opts: ["A) FORMAT_DATE()", "B) DATE_FORMAT()", "C) TO_DATE()"], ans: "B" },
      6  => { type: "true_false",      q: "GROUP_CONCAT() aggregates multiple row values into a single comma-separated string.",
              opts: ["True", "False"], ans: "True" },
      7  => { type: "multiple_choice", q: "MySQL does NOT natively support which JOIN type?",
              opts: ["A) LEFT JOIN", "B) FULL OUTER JOIN", "C) INNER JOIN"], ans: "B" },
      8  => { type: "true_false",      q: "A subquery written in the FROM clause, such as FROM (SELECT ...) AS dept_avgs, is called a derived table.",
              opts: ["True", "False"], ans: "True" },
      9  => { type: "multiple_choice", q: "Which statement creates or replaces an existing view?",
              opts: ["A) CREATE OR REPLACE VIEW", "B) CREATE VIEW", "C) UPDATE VIEW"], ans: "A" },
      10 => { type: "true_false",      q: "In the mysql command-line client, you change the DELIMITER before creating a stored procedure because the procedure body contains semicolons.",
              opts: ["True", "False"], ans: "True" },
      11 => { type: "multiple_choice", q: "How is a stored function different from a stored procedure?",
              opts: ["A) Functions cannot accept any parameters at all", "B) Functions return a single value and can be used in SQL expressions", "C) Functions must be executed with CALL, just like procedures"], ans: "B" },
      12 => { type: "multiple_choice", q: "Inside a trigger, what do OLD and NEW refer to?",
              opts: ["A) The previous and next tables in the database", "B) The old and new versions of the database schema", "C) The row's values before and after the triggering operation"], ans: "C" },
      13 => { type: "true_false",      q: "MyISAM tables support ROLLBACK in the same way that InnoDB tables do.",
              opts: ["True", "False"], ans: "False" },
      14 => { type: "multiple_choice", q: "A table has a composite index on (dept, salary). Which WHERE clause can NOT use this index effectively?",
              opts: ["A) WHERE dept = 'HR'", "B) WHERE dept = 'HR' AND salary > 80000", "C) WHERE salary > 80000 (on its own)"], ans: "C" },
      15 => { type: "true_false",      q: "A user created as 'appuser'@'localhost' can connect to MySQL from any host.",
              opts: ["True", "False"], ans: "False" },
      16 => { type: "multiple_choice", q: "Which operator is shorthand for JSON_EXTRACT in MySQL?",
              opts: ["A) ->", "B) =>", "C) :>"], ans: "A" },
      17 => { type: "true_false",      q: "Like GROUP BY, window functions reduce the number of rows returned by a query.",
              opts: ["True", "False"], ans: "False" },
      18 => { type: "multiple_choice", q: "Which MySQL syntax performs a full-text search?",
              opts: ["A) MATCH(col) AGAINST ('term')", "B) SEARCH(col) FOR 'term'", "C) FULLTEXT(col) LIKE 'term'"], ans: "A" },
      19 => { type: "true_false",      q: "With a prepared statement such as SELECT * FROM users WHERE email = ?, the user's input is sent separately as a parameter instead of being concatenated into the SQL text.",
              opts: ["True", "False"], ans: "True" },
      20 => { type: "multiple_choice", q: "Which MySQL feature automatically runs SQL code when a table row is inserted, updated, or deleted?",
              opts: ["A) View", "B) Index", "C) Trigger"], ans: "C" }
    }

    MysqlContent::LESSONS.each do |position, data|
      lesson = CourseLesson.find_or_create_by!(course: course, position: position) do |l|
        l.title = titles[position]; l.description = ""
      end
      lesson.update!(title: titles[position], body: data[:body], starter_code: data[:starter_code])

      ex = exercises[position]
      Exercise.find_or_initialize_by(course_lesson: lesson).tap do |e|
        e.exercise_type = ex[:type]; e.question = ex[:q]
        e.options = ex[:opts]; e.correct_answer = ex[:ans]
      end.save!
      puts "  ✓ #{position}. #{titles[position]}"
    end

    puts "Done! #{CourseLesson.where(course: course).count} lessons, #{Exercise.joins(:course_lesson).where(course_lessons: { course_id: course.id }).count} exercises."
  end
end
